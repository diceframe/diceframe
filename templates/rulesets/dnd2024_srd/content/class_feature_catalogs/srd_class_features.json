    "fighter": {
      "source_ref": "srd-5.2.1:p47:fighter-features",
      "features": [
        {
          "id": "second_wind",
          "minimum_level": 1,
          "source_ref": "srd-5.2.1:p48:second-wind",
          "summary": "Bonus Action: regain HP equal to 1d10 plus your Fighter level. You have two uses (three at Fighter level 4, four at level 10); regain one use on a Short Rest and all uses on a Long Rest.",
          "parameters": {
            "heal_dice": "1d10",
            "heal_bonus_track": "second_wind_heal_bonus"
          },
          "resource_id": "second_wind",
          "capabilities": [
            {
              "id": "second_wind",
              "cost": {"bonus_action": 1, "resources": [{"id": "second_wind", "amount": 1}]},
              "requires_hostile_target": false,
              "actions": [{"kind": "heal", "count": 1}]
            }
          ]
        },
        {
          "id": "weapon_mastery",
          "minimum_level": 1,
          "source_ref": "srd-5.2.1:p42:weapon-mastery",
          "summary": "You can use the mastery properties of your weapons. (This slice approximates the chosen-weapons list with an 'equipped weapon' unlock; the count track is not yet consumed.)"
        },
        {
          "id": "action_surge",
          "minimum_level": 2,
          "source_ref": "srd-5.2.1:p48:action-surge",
          "summary": "On your turn, you can take one additional action, except the Magic action. Starting at level 17, you can use it twice before a rest, but only once on a turn.",
          "parameters": {},
          "resource_id": "action_surge",
          "capabilities": [
            {
              "id": "action_surge",
              "cost": {"resources": [{"id": "action_surge", "amount": 1}]},
              "requires_hostile_target": false,
              "once_per_turn": true,
              "actions": [{"kind": "action_surge", "count": 1}]
            }
          ]
        },
        {
          "id": "extra_attack",
          "minimum_level": 5,
          "summary": "When you take the Attack action, you can attack twice instead of once. Extra Attack never stacks: a character that gains it from a second class uses the highest value, not the sum.",
          "parameters": {"attacks_per_action": 2}
        },
        {
          "id": "improved_critical",
          "owner": "subclass:champion",
          "minimum_level": 3,
          "source_ref": "srd-5.2.1:p49:improved-critical",
          "summary": "Your attack rolls with weapons and Unarmed Strikes can score a Critical Hit on a roll of 19 or 20 on the d20.",
          "parameters": {"crit_threshold": 19}
        },
        {
          "id": "additional_fighting_style",
          "owner": "subclass:champion",
          "minimum_level": 7,
          "source_ref": "srd-5.2.1:p49:additional-fighting-style",
          "summary": "You gain another Fighting Style feat of your choice.",
          "choice": {
            "id": "fighting_style_feat",
            "kind": "advancement_feat",
            "category": "fighting_style",
            "count": 1,
            "enabled_options": ["feat:archery", "feat:defense"]
          }
        },
        {
          "id": "two_extra_attacks",
          "minimum_level": 11,
          "summary": "When you take the Attack action, you can attack three times instead of once.",
          "parameters": {"attacks_per_action": 3}
        },
        {
          "id": "superior_critical",
          "owner": "subclass:champion",
          "minimum_level": 15,
          "source_ref": "srd-5.2.1:p49:superior-critical",
          "summary": "Your attack rolls with weapons and Unarmed Strikes can now score a Critical Hit on a roll of 18-20 on the d20.",
          "parameters": {"crit_threshold": 18}
        },
        {
          "id": "survivor",
          "owner": "subclass:champion",
          "minimum_level": 18,
          "source_ref": "srd-5.2.1:p49:survivor",
          "summary": "You have Advantage on Death Saving Throws, treat a roll of 18-20 on one as a 20, and while Bloodied you regain 5 plus your Constitution modifier Hit Points at the start of each of your turns.",
          "parameters": {
            "death_save_advantage": true,
            "death_save_crit_threshold": 18,
            "turn_start_regen_base": 5,
            "turn_start_regen_ability": "con"
          }
        },
        {
          "id": "three_extra_attacks",
          "minimum_level": 20,
          "summary": "When you take the Attack action, you can attack four times instead of once.",
          "parameters": {"attacks_per_action": 4}
        }
      ]
    },
    "barbarian": {
      "source_ref": "srd-5.2.1:p28:barbarian-features",
      "features": [
        {
          "id": "unarmored_defense",
          "minimum_level": 1,
          "source_ref": "srd-5.2.1:p29:unarmored-defense",
          "summary": "While you aren't wearing armor, your base Armor Class equals 10 plus your Dexterity and Constitution modifiers. You can use a Shield and still gain this benefit.",
          "parameters": {"unarmored_ac_ability_bonus": "con"},
          "equipment_requirement": {"unarmored": true}
        },
        {
          "id": "fast_movement",
          "minimum_level": 5,
          "source_ref": "srd-5.2.1:p29:fast-movement",
          "summary": "Your Speed increases by 10 feet while you aren't wearing Heavy armor. A Shield does not interfere.",
          "parameters": {"speed_bonus_ft": 10},
          "equipment_requirement": {"no_heavy_armor": true}
        },
        {
          "id": "rage",
          "minimum_level": 1,
          "source_ref": "srd-5.2.1:p28:rage",
          "summary": "Bonus Action: enter a Rage. While raging, Strength attacks and Unarmed Strikes deal extra damage (see the Barbarian table), and your Strength saving throws have advantage. You cannot cast spells or maintain Concentration while raging; entering a Rage ends Concentration. The Rage lasts until the end of your next turn; making an attack against an enemy, or using a Bonus Action, extends it for another turn, up to 10 turns. It ends early if you are Incapacitated. You regain one use on a Short Rest and all uses on a Long Rest.",
          "parameters": {
            "rage_damage_track": "rage_damage"
          },
          "resource_id": "rages",
          "capabilities": [
            {
              "id": "rage",
              "cost": {"bonus_action": 1, "resources": [{"id": "rages", "amount": 1}]},
              "requires_hostile_target": false,
              "forbidden_condition": "rage",
              "actions": [{"kind": "rage", "count": 1}]
            },
            {
              "id": "rage_sustain",
              "cost": {"bonus_action": 1},
              "requires_hostile_target": false,
              "requires_condition": "rage",
              "actions": [{"kind": "rage_sustain", "count": 1}]
            }
          ]
        },
        {
          "id": "retaliation",
          "owner": "subclass:path_of_the_berserker",
          "minimum_level": 10,
          "source_ref": "srd-5.2.1:p30:retaliation",
          "summary": "When a creature within 5 feet of you deals damage to you, you can use your Reaction to make one melee attack against it using a weapon or an Unarmed Strike.",
          "parameters": {"counterattack_range": 5}
        }
      ]
    },
    "rogue": {
      "source_ref": "srd-5.2.1:p61:rogue-features",
      "features": [
        {
          "id": "sneak_attack",
          "minimum_level": 1,
          "source_ref": "srd-5.2.1:p61:sneak-attack",
          "summary": "Once per turn, when you hit with an attack using a Finesse or Ranged weapon, deal extra damage if you have Advantage, or if an ally who is not Incapacitated is within 5 feet of the target and you do not have Disadvantage. The damage type matches the weapon.",
          "parameters": {
            "damage_dice_track": "sneak_attack_dice",
            "damage_dice_format": "{die}d6"
          }
        },
        {
          "id": "cunning_action",
          "minimum_level": 2,
          "source_ref": "srd-5.2.1:p63:cunning-action",
          "summary": "You can take the Dash, Disengage, or Hide action as a Bonus Action.",
          "capabilities": [
            {"id": "cunning_dash", "cost": {"bonus_action": 1},
             "requires_hostile_target": false, "actions": [{"kind": "dash"}]},
            {"id": "cunning_disengage", "cost": {"bonus_action": 1},
             "requires_hostile_target": false, "actions": [{"kind": "disengage"}]},
            {"id": "cunning_hide", "cost": {"bonus_action": 1},
             "requires_hostile_target": false, "actions": [{"kind": "hide"}]}
          ]
        },
        {
          "id": "fast_hands",
          "owner": "subclass:thief",
          "minimum_level": 3,
          "source_ref": "srd-5.2.1:p64:fast-hands",
          "summary": "You can use a Bonus Action to make a Sleight of Hand check or to take the Utilize action.",
          "parameters": {}
        },
        {
          "id": "uncanny_dodge",
          "minimum_level": 5,
          "source_ref": "srd-5.2.1:p63:uncanny-dodge",
          "summary": "When an attacker that you can see hits you with an attack, you can use your Reaction to halve the attack's damage against you (rounded down).",
          "parameters": {
