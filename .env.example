# Docker host port. Container still listens on 9876.
DICEFRAME_HTTP_PORT=9876

# Timezone used for runtime log timestamps. The image defaults to Asia/Shanghai;
# set another IANA zone here (e.g. Europe/Berlin) to override it.
TZ=Asia/Shanghai

# Optional public-content mirror. Leave blank to use the official source.
DICEFRAME_CONTENT_BASE_URL=

# Configure AI connections in WebUI -> AI Providers, then assign model routing.
# AI capability-specific environment variables (TRPG_LLM_*, TRPG_EMBEDDING_*,
# TRPG_TTS_*, TRPG_ASR_*, TRPG_IMAGEGEN_*) are no longer supported.
# Browser and edge-tts voices need no provider reference; disabled ASR needs none.
# Local compatible providers may leave their API key empty.

# Optional fixed WebUI login token. Leave blank to auto-generate into data/access_token.txt.
TRPG_ACCESS_TOKEN=

# Optional origins for an independently hosted WebUI, comma-separated.
# When set, this environment value overrides the WebUI CORS setting.
# Example: https://diceframe.pages.dev,https://play.example.com
TRPG_WEB_CORS_ORIGINS=

# Optional HTTP proxy, for example http://host.docker.internal:7890
TRPG_PROXY_URL=

# Optional Bot API override. Leave blank to let DiceFrame generate and persist a token;
# external bridges can copy it from Settings -> Bot API.
TRPG_BOT_TOKEN=

# Optional QQ / NapCat plugin settings. Leave blank and configure in WebUI if preferred.
# If NapCat runs on the same Linux host outside Docker, host.docker.internal is mapped
# by docker-compose.yml; a real LAN IP also works.
NAPCAT_HOST=
NAPCAT_PORT=
NAPCAT_TOKEN=
